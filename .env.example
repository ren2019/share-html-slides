# Production must be an HTTPS management origin. Use http://localhost:3000 only with pnpm dev.
APP_URL=http://localhost:3000
# Generate a random secret of at least 32 characters; never commit it.
BETTER_AUTH_SECRET=
# Local Node: PostgreSQL URL. Compose: use hostname db. URL-encode password characters.
DATABASE_URL=
# Compose database password (set separately from DATABASE_URL).
POSTGRES_PASSWORD=
# Optional deployer-managed SMS gateway. Without both fields, signup/reset are disabled.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
